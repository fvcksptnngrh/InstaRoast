# 🔥 InstaRoaster - Environment Variables
#
# Copy file ini ke .env.local lalu isi nilainya:
#   cp env.example .env.local

# ===========================================
# OPENAI (WAJIB untuk roast AI)
# ===========================================

# Dapatkan API key dari: https://platform.openai.com/api-keys
# Model yang dipakai: gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# REDIS / UPSTASH (WAJIB untuk rate limiting)
# ===========================================

# Dapatkan dari: https://console.upstash.com/
KV_REST_API_URL=your_upstash_redis_url
KV_REST_API_TOKEN=your_upstash_redis_token

# ===========================================
# OPSIONAL
# ===========================================

# Port development server (default: 3000)
# PORT=3002

# Environment
# NODE_ENV=development

# Google Analytics
# GA_TRACKING_ID=your_ga_tracking_id

# Vercel Analytics
# VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# ===========================================
# CATATAN
# ===========================================
#
# ✅ OPENAI_API_KEY wajib — tanpa ini, app pakai fallback roast template
# ✅ KV_REST_* wajib untuk rate limiting (4 akun / 20 menit)
# ✅ Instagram data diambil dari public API (gratis)
# ⚠️ JANGAN commit file .env.local — sudah di-ignore oleh .gitignore
